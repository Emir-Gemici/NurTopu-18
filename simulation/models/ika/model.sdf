<?xml version="1.0"?>
<!--
  Navitas İKA — 4 tekerlekli diferansiyel sürüş rover (şartname 5.3), RPi5 + kamera.
  TANK-benzeri tasarım: GENİŞ alçak şasi + iri tekerlekler + paletvari yan korumalar +
  alçak ağırlık merkezi (devrilmez) + 200gr yük platformu. base_link / left_rear_joint /
  right_rear_joint isimleri KORUNDU (diff-drive ve kayıt anim plugin'i bunlara bağlı).
  NOT: eski beacon direk+disk KALDIRILDI (devriliyordu, ağırlık merkezini bozuyordu).
-->
<sdf version="1.6">
  <model name="ika">
    <static>false</static>

    <!-- ── Gövde ──────────────────────────────────────────────────── -->
    <link name="base_link">
      <inertial>
        <!-- Ağırlık merkezi ALÇAK (tekerlek hizası) → moloza çarpınca DEVRİLMEZ -->
        <pose>0 0 -0.07 0 0 0</pose>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.18</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.26</iyy><iyz>0</iyz>
          <izz>0.38</izz>
        </inertia>
      </inertial>

      <!-- Ana şasi (GENİŞ alçak gövde — tank gövdesi) -->
      <collision name="body_col">
        <geometry><box><size>0.66 0.50 0.14</size></box></geometry>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
        </surface>
      </collision>
      <visual name="body_vis">
        <geometry><box><size>0.66 0.50 0.14</size></box></geometry>
        <material>
          <ambient>0.20 0.26 0.16 1</ambient>
          <diffuse>0.28 0.34 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Sol/sağ palet benzeri yan korumalar (tank görünümü, tekerlekleri örter) -->
      <visual name="track_L">
        <pose>0 0.27 -0.06 0 0 0</pose>
        <geometry><box><size>0.62 0.08 0.16</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="track_R">
        <pose>0 -0.27 -0.06 0 0 0</pose>
        <geometry><box><size>0.62 0.08 0.16</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>

      <!-- Üst elektronik kutusu (RPi + güç) — alçak ve geniş -->
      <visual name="ebox_vis">
        <pose>-0.06 0 0.10 0 0 0</pose>
        <geometry><box><size>0.34 0.34 0.08</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.20 1</diffuse></material>
      </visual>

      <!-- 200gr+ yük platformu (şartname: min 200gr yük) — turuncu kasa -->
      <visual name="payload_vis">
        <pose>-0.06 0 0.17 0 0 0</pose>
        <geometry><box><size>0.16 0.16 0.06</size></box></geometry>
        <material><ambient>0.7 0.35 0.0 1</ambient><diffuse>0.95 0.5 0.05 1</diffuse></material>
      </visual>

      <!-- Ön tampon (koyu) -->
      <visual name="bumper_vis">
        <pose>0.34 0 -0.02 0 0 0</pose>
        <geometry><box><size>0.04 0.50 0.10</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>

      <!-- Kamera (ön-üst, alçak — gövdeye gömülü) -->
      <visual name="cam_body_vis">
        <pose>0.28 0 0.11 0 0 0</pose>
        <geometry><box><size>0.05 0.07 0.05</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- Anten (kısa, alçak) -->
      <visual name="antenna_vis">
        <pose>-0.26 0.18 0.16 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.14</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- ── Ön kamera (RPi kamera) — ileri/aşağı bakan ─────────────── -->
      <sensor name="front_camera" type="camera">
        <pose>0.30 0 0.13 0 0.15 0</pose>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>50</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>

      <!-- LiDAR (2D) -->
      <sensor name="lidar" type="ray">
        <pose>0 0 0.15 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range><min>0.10</min><max>30.0</max><resolution>0.01</resolution></range>
          <!-- Gazebo Classic ray/range şeması type'ı çocuk eleman olarak bekler;
               IMU/GPS noise ise SDF 1.6'da attribute biçimini kullanır. -->
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
      </sensor>

      <!-- GPS -->
      <sensor name="gps" type="gps">
        <pose>0 0 0.12 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <gps>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0</mean><stddev>0.3</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0</mean><stddev>0.6</stddev></noise></vertical>
          </position_sensing>
        </gps>
      </sensor>

      <!-- IMU -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ── Tekerlekler (4× silindir, daha iri) ────────────────────── -->
    <link name="left_front_wheel">
      <pose>0.22 0.27 -0.10 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0010</iyy><iyz>0</iyz><izz>0.0010</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_front_joint" type="revolute">
      <parent>base_link</parent><child>left_front_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="right_front_wheel">
      <pose>0.22 -0.27 -0.10 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0010</iyy><iyz>0</iyz><izz>0.0010</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_front_joint" type="revolute">
      <parent>base_link</parent><child>right_front_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="left_rear_wheel">
      <pose>-0.22 0.27 -0.10 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0010</iyy><iyz>0</iyz><izz>0.0010</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_rear_joint" type="revolute">
      <parent>base_link</parent><child>left_rear_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="right_rear_wheel">
      <pose>-0.22 -0.27 -0.10 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0010</iyy><iyz>0</iyz><izz>0.0010</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_rear_joint" type="revolute">
      <parent>base_link</parent><child>right_rear_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- NOT: diferansiyel sürüş modeli FİZİKSEL olarak korunur (4 teker + arka aks joint'leri),
         ANCAK libDiffDrivePlugin.so KALDIRILDI: komutsuzken tekerleri 0 hıza FRENLİYOR; bu da
         kayıt anim plugin'inin gövdeye uyguladığı sınırlı traksiyon kuvvetini (statik sürtünme
         > kuvvet → kilitlenme) etkisizleştiriyordu. Sim'de aracı navitas_anim sürer; tekerler
         serbest döner (yer sürtünmesiyle yuvarlanır). Sahada gerçek diff-drive sürücü kullanılır. -->
  </model>
</sdf>
