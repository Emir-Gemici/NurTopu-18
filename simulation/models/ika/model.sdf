<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ika">
    <static>false</static>

    <!-- ── Gövde ──────────────────────────────────────────────────── -->
    <link name="base_link">
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.1317</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.1988</iyy><iyz>0</iyz>
          <izz>0.2700</izz>
        </inertia>
      </inertial>

      <collision name="body_col">
        <geometry><box><size>0.6 0.4 0.2</size></box></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="body_vis">
        <geometry><box><size>0.6 0.4 0.2</size></box></geometry>
        <material>
          <ambient>0.0 0.6 0.1 1</ambient>
          <diffuse>0.0 0.6 0.1 1</diffuse>
        </material>
      </visual>

      <!-- LiDAR (2D) -->
      <sensor name="lidar" type="ray">
        <pose>0 0 0.15 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range><min>0.10</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
      </sensor>

      <!-- GPS -->
      <sensor name="gps" type="gps">
        <pose>0 0 0.12 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <gps>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0</mean><stddev>0.3</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0</mean><stddev>0.6</stddev></noise></vertical>
          </position_sensing>
        </gps>
      </sensor>

      <!-- IMU -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ── Sol ön tekerlek ─────────────────────────────────────────── -->
    <link name="left_front_wheel">
      <pose>0.22 0.23 -0.12 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0010</iyy><iyz>0</iyz><izz>0.0010</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_front_joint" type="revolute">
      <parent>base_link</parent><child>left_front_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ── Sağ ön tekerlek ─────────────────────────────────────────── -->
    <link name="right_front_wheel">
      <pose>0.22 -0.23 -0.12 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0010</iyy><iyz>0</iyz><izz>0.0010</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_front_joint" type="revolute">
      <parent>base_link</parent><child>right_front_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ── Sol arka tekerlek (sürülen) ────────────────────────────── -->
    <link name="left_rear_wheel">
      <pose>-0.22 0.23 -0.12 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0010</iyy><iyz>0</iyz><izz>0.0010</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_rear_joint" type="revolute">
      <parent>base_link</parent><child>left_rear_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ── Sağ arka tekerlek (sürülen) ────────────────────────────── -->
    <link name="right_rear_wheel">
      <pose>-0.22 -0.23 -0.12 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0010</iyy><iyz>0</iyz><izz>0.0010</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_rear_joint" type="revolute">
      <parent>base_link</parent><child>right_rear_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ── Native Gazebo diferansiyel sürüş ───────────────────────── -->
    <!-- ROS gerektirmez. Kontrol: gz topic -p ~/ika/vel_cmd            -->
    <plugin name="diff_drive" filename="libDiffDrivePlugin.so">
      <left_joint>left_rear_joint</left_joint>
      <right_joint>right_rear_joint</right_joint>
      <wheel_separation>0.46</wheel_separation>
      <wheel_diameter>0.14</wheel_diameter>
      <torque>20</torque>
    </plugin>
  </model>
</sdf>
