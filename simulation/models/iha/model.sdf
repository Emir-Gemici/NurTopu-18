<?xml version="1.0"?>
<sdf version="1.6">
  <model name="iha">
    <static>true</static>

    <!-- ── Gövde (fuselage) ─────────────────────────────────────── -->
    <link name="base_link">
      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.0820</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4180</iyy><iyz>0</iyz>
          <izz>0.4660</izz>
        </inertia>
      </inertial>

      <collision name="fuselage_col">
        <geometry><box><size>1.2 0.15 0.12</size></box></geometry>
      </collision>
      <visual name="fuselage_vis">
        <geometry><box><size>1.2 0.15 0.12</size></box></geometry>
        <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
      </visual>

      <!-- Sol kanat -->
      <collision name="left_wing_col">
        <pose>0 0.65 0 0 0 0</pose>
        <geometry><box><size>0.8 1.1 0.04</size></box></geometry>
      </collision>
      <visual name="left_wing_vis">
        <pose>0 0.65 0 0 0 0</pose>
        <geometry><box><size>0.8 1.1 0.04</size></box></geometry>
        <material><ambient>0.3 0.3 0.9 1</ambient><diffuse>0.3 0.3 0.9 1</diffuse></material>
      </visual>

      <!-- Sağ kanat -->
      <collision name="right_wing_col">
        <pose>0 -0.65 0 0 0 0</pose>
        <geometry><box><size>0.8 1.1 0.04</size></box></geometry>
      </collision>
      <visual name="right_wing_vis">
        <pose>0 -0.65 0 0 0 0</pose>
        <geometry><box><size>0.8 1.1 0.04</size></box></geometry>
        <material><ambient>0.3 0.3 0.9 1</ambient><diffuse>0.3 0.3 0.9 1</diffuse></material>
      </visual>

      <!-- Kuyruk dikey -->
      <collision name="vtail_col">
        <pose>-0.52 0 0.12 0 0 0</pose>
        <geometry><box><size>0.28 0.03 0.22</size></box></geometry>
      </collision>
      <visual name="vtail_vis">
        <pose>-0.52 0 0.12 0 0 0</pose>
        <geometry><box><size>0.28 0.03 0.22</size></box></geometry>
        <material><ambient>0.1 0.1 0.7 1</ambient><diffuse>0.1 0.1 0.7 1</diffuse></material>
      </visual>

      <!-- Kuyruk yatay -->
      <collision name="htail_col">
        <pose>-0.52 0 0.04 0 0 0</pose>
        <geometry><box><size>0.26 0.52 0.03</size></box></geometry>
      </collision>
      <visual name="htail_vis">
        <pose>-0.52 0 0.04 0 0 0</pose>
        <geometry><box><size>0.26 0.52 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.7 1</ambient><diffuse>0.1 0.1 0.7 1</diffuse></material>
      </visual>

      <!-- Kamera sensörü (burun altı) -->
      <sensor name="front_camera" type="camera">
        <pose>0.62 0 -0.09 0 0.3 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>300</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>

      <!-- IMU -->
      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- GPS -->
      <sensor name="gps" type="gps">
        <pose>0 0 0.06 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <gps>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0</mean><stddev>0.5</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0</mean><stddev>1.0</stddev></noise></vertical>
          </position_sensing>
        </gps>
      </sensor>
    </link>
  </model>
</sdf>
