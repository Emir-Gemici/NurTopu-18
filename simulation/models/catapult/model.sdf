<?xml version="1.0"?>
<sdf version="1.6">
  <model name="catapult">
    <static>true</static>
    <!-- Rampa tabanı -->
    <link name="base">
      <visual name="base_vis">
        <geometry><box><size>3.0 0.6 0.15</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
      </visual>
      <collision name="base_col">
        <geometry><box><size>3.0 0.6 0.15</size></box></geometry>
      </collision>
    </link>
    <!-- Rampa eğimli yüzey (15 derece yukarı) -->
    <link name="ramp">
      <pose>0.2 0 0.3 0 -0.2618 0</pose>
      <visual name="ramp_vis">
        <geometry><box><size>2.8 0.5 0.05</size></box></geometry>
        <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
      </visual>
      <collision name="ramp_col">
        <geometry><box><size>2.8 0.5 0.05</size></box></geometry>
      </collision>
    </link>
    <joint name="ramp_joint" type="fixed">
      <parent>base</parent><child>ramp</child>
    </joint>
    <!-- Sol ayak -->
    <link name="left_leg">
      <pose>-1.3 0.25 -0.3 0 0 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.04</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.6</length></cylinder></geometry></collision>
    </link>
    <joint name="left_leg_joint" type="fixed"><parent>base</parent><child>left_leg</child></joint>
    <!-- Sağ ayak -->
    <link name="right_leg">
      <pose>-1.3 -0.25 -0.3 0 0 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.04</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.6</length></cylinder></geometry></collision>
    </link>
    <joint name="right_leg_joint" type="fixed"><parent>base</parent><child>right_leg</child></joint>
  </model>
</sdf>
