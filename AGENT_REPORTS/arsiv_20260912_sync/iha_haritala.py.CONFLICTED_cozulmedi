class _KareYerlesimi:
    """Bir tarama karesinin dünya ızgarasındaki yerleşimi — TEK GEOMETRİ KAYNAĞI.

    Mozaik de, oy haritası da bu nesneden geçer: ölçek, dönüş, geçerlilik maskesi
    ve tuval dilimi ikisinde de BİREBİR aynıdır. İki ayrı kopya olsaydı
    (mozaikte bir dönüşüm, oylamada başkası) maskeler sessizce kayardı.
    """
    __slots__ = ("k", "t", "poz", "ham", "M", "ayak_px", "gecerli",
                 "sx0", "sy0", "dx0", "dy0", "w", "h", "px", "py")

    def __init__(self, k, t, poz, ham, M, ayak_px, gecerli,
                 sx0, sy0, dx0, dy0, w, h, px, py):
        self.k, self.t, self.poz, self.ham = k, t, poz, ham
        self.M, self.ayak_px, self.gecerli = M, ayak_px, gecerli
        self.sx0, self.sy0, self.dx0, self.dy0 = sx0, sy0, dx0, dy0
        self.w, self.h, self.px, self.py = w, h, px, py

    def dilim(self, tuval):
        """Bu karenin tuvaldeki hedef dilimini (GÖRÜNÜM — yazınca tuval değişir) dön."""
        return tuval[self.dy0:self.dy0 + self.h, self.dx0:self.dx0 + self.w]

    def yansit(self, kaynak, *, olcek_interp, dondur_interp, kenar=0):
        """`kaynak`ı kare ayağına ölçekle + yaw ile döndür + tuval dilimine kırp.

        Döner: (kırpılmış kaynak, geçerlilik maskesi bool). Kare dışına taşan
        bölge maskede False'tur — orası OY VERMEZ / mozaiğe yazmaz.
        """
        import cv2

        a = self.ayak_px
        if kaynak.shape[0] != a or kaynak.shape[1] != a:
            kaynak = cv2.resize(kaynak, (a, a), interpolation=olcek_interp)
        kaynak = cv2.warpAffine(kaynak, self.M, (a, a),
                                flags=dondur_interp, borderValue=kenar)
        return (kaynak[self.sy0:self.sy0 + self.h, self.sx0:self.sx0 + self.w],
                self.gecerli[self.sy0:self.sy0 + self.h,
                             self.sx0:self.sx0 + self.w] > 0)


