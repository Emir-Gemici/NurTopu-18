def _piksel_maskede(px, maske):
    if px is None or maske is None:
        return None
    x, y = px
    h, w = maske.shape[:2]
    if not (0 <= x < w and 0 <= y < h):
        return False
    return bool(maske[y, x] > 0)


def _ayni_serbest_bilesen(kb_px, hb_px, serbest):
    """KB/HB pikselleri serbest alanin ayni bagli bilesenindeyse True."""
    if kb_px is None or hb_px is None or serbest is None:
        return None
    import cv2
    import numpy as np

    h, w = serbest.shape[:2]
    kx, ky = kb_px
    hx, hy = hb_px
    if not (0 <= kx < w and 0 <= ky < h and 0 <= hx < w and 0 <= hy < h):
        return False
    n, etiket = cv2.connectedComponents((np.asarray(serbest) > 0).astype(np.uint8), 8)
    if n <= 1:
        return False
    kb_bilesen = int(etiket[ky, kx])
    hb_bilesen = int(etiket[hy, hx])
    return bool(kb_bilesen != 0 and kb_bilesen == hb_bilesen)


def _tohumlar_ayni_bilesende(kb_tohum, hb_tohum, gecilebilir):
    """C-uzayındaki KB/HB tohum kümeleri ortak bir bileşene değiyor mu?"""
    if kb_tohum is None or hb_tohum is None or gecilebilir is None:
        return None
    import cv2
    import numpy as np

    alan = (np.asarray(gecilebilir) > 0).astype(np.uint8)
    if not alan.any() or not np.asarray(kb_tohum).any() or not np.asarray(hb_tohum).any():
        return False
    _n, etiket = cv2.connectedComponents(alan, 8)
    kb_bilesenleri = set(np.unique(etiket[np.asarray(kb_tohum) > 0])) - {0}
    hb_bilesenleri = set(np.unique(etiket[np.asarray(hb_tohum) > 0])) - {0}
    return bool(kb_bilesenleri & hb_bilesenleri)


