def _atomik_yaz(path, metin):
    """Tam yazilmamis bir rota dosyasinin tuketicilerce gorulmesini engelle."""
    path = Path(path)
    gecici = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        gecici.write_text(metin, encoding="utf-8")
        gecici.replace(path)
    finally:
        if gecici.exists():
            gecici.unlink()


