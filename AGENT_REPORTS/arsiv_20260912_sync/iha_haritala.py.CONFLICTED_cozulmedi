    """HER KAREDE model koştur, dünya ızgarasında OY BİRİKTİR (+ mozaiği aynı geçişte kur).

    Model, kare MOZAİĞE ÖLÇEKLENMEDEN ÖNCE ham hâlinde görür — amacın tamamı bu:
    ağırlıklar gerçek drone kareleriyle eğitildi, ortomozaik kolajıyla değil.
    Karenin zemin/engel maskesi, karenin KENDİ pozuyla (mozaikle birebir aynı
    dönüşüm) MOZ_PX×MOZ_PX ızgaraya yansıtılır; kare dışına taşan bölge OY VERMEZ.

    Döner: (mozaik BGR, kullanılan_kare, oy dict{zemin_oy, engel_oy, gozlem,
            cikarim_sn, kare_sayisi}).
    """
    import cv2
    import numpy as np

    canvas = _bos_tuval()
    zemin_oy = np.zeros((MOZ_PX, MOZ_PX), dtype=np.int32)
    engel_oy = np.zeros((MOZ_PX, MOZ_PX), dtype=np.int32)
    gozlem = np.zeros((MOZ_PX, MOZ_PX), dtype=np.int32)
    kullanilan = 0
    cikarim_sn = 0.0

    for yerlesim in _kare_yerlesimleri(kare_dir, pozlar, htab_cx, htab_cy,
                                       kare_ofset=kare_ofset,
                                       rot_isaret=rot_isaret,
                                       kare_atlama=kare_atlama, debug=debug):
        _tuvale_yaz(yerlesim, canvas)          # görsel kanıt (karar zinciri DEĞİL)

        # ── MODEL: HAM KARE (ölçeklenmemiş, döndürülmemiş) ────────────────────
        t0 = time.perf_counter()
        _icerik, maskeler, _yol, _guv, _wps, _kaz = _infer(
            yerlesim.ham, model, conf, MOZ_PX)
        cikarim_sn += time.perf_counter() - t0

        zemin_k = (np.asarray(maskeler[0]) > 0).astype(np.uint8)
        engel_k = (np.asarray(maskeler[1]) > 0).astype(np.uint8)
        z_yans, gecerli = yerlesim.yansit(
            zemin_k, olcek_interp=cv2.INTER_NEAREST,
            dondur_interp=cv2.INTER_NEAREST, kenar=0)
        e_yans, _ = yerlesim.yansit(
            engel_k, olcek_interp=cv2.INTER_NEAREST,
            dondur_interp=cv2.INTER_NEAREST, kenar=0)

        yerlesim.dilim(gozlem)[gecerli] += 1
        yerlesim.dilim(zemin_oy)[gecerli & (z_yans > 0)] += 1
        yerlesim.dilim(engel_oy)[gecerli & (e_yans > 0)] += 1
        kullanilan += 1

    return canvas, kullanilan, {
        "zemin_oy": zemin_oy,
        "engel_oy": engel_oy,
        "gozlem": gozlem,
        "cikarim_sn": round(cikarim_sn, 3),
        "kare_sayisi": kullanilan,
    }


def oy_haritasindan_maske(oy, min_gozlem=MIN_GOZLEM, engel_orani=ENGEL_ORANI):
    """Oy birikimlerinden zemin/engel/bilinmeyen maskelerini türet.

    KURAL (proje anayasası madde 15 — serbest alan büyütülemez):
      · gozlem < min_gozlem                → BİLİNMEYEN, zemin=0 (GEÇİLEBİLİR DEĞİL)
      · zemin_oy + engel_oy == 0           → BİLİNMEYEN (model sustu = yol değil)
      · engel_oy / (zemin_oy + engel_oy) >= engel_orani → ENGEL
      · aksi hâlde                         → ZEMİN
    Eşiklerin gerekçesi MIN_GOZLEM / ENGEL_ORANI tanımlarındadır (ön kayıt).

    Döner: (zemin uint8, engel uint8, bilinmeyen uint8, özet dict).
    """
    import numpy as np

    zemin_oy = np.asarray(oy["zemin_oy"], dtype=np.int64)
    engel_oy = np.asarray(oy["engel_oy"], dtype=np.int64)
    gozlem = np.asarray(oy["gozlem"], dtype=np.int64)

    toplam = zemin_oy + engel_oy
    karar_var = (gozlem >= int(min_gozlem)) & (toplam > 0)
    engel_p = np.zeros(gozlem.shape, dtype=np.float64)
    np.divide(engel_oy, toplam, out=engel_p, where=toplam > 0)

    engel = (karar_var & (engel_p >= float(engel_orani))).astype(np.uint8)
    zemin = (karar_var & (engel_p < float(engel_orani))).astype(np.uint8)
    bilinmeyen = (~karar_var).astype(np.uint8)

    hucre = max(1, int(gozlem.size))
    gorulen = gozlem[gozlem > 0]
    ozet = {
        "yontem": "kare_basi_oylama",
        "kare_sayisi": int(oy.get("kare_sayisi", 0)),
        "min_gozlem": int(min_gozlem),
        "engel_orani": float(engel_orani),
        "bilinmeyen_hucre_orani": round(float(np.count_nonzero(bilinmeyen)) / hucre, 6),
        "ortalama_gozlem": (round(float(gorulen.mean()), 3) if gorulen.size else 0.0),
        "cikarim_sn": float(oy.get("cikarim_sn", 0.0)),
    }
    return zemin, engel, bilinmeyen, ozet


def oy_haritasi_gorseli(zemin, engel, bilinmeyen):
    """zemin / engel / bilinmeyen → 3 renkli geliştirici kanıtı görseli (BGR)."""
    import numpy as np

    gorsel = np.zeros((zemin.shape[0], zemin.shape[1], 3), dtype=np.uint8)
    gorsel[np.asarray(bilinmeyen) > 0] = OY_RENK["bilinmeyen"]
    gorsel[np.asarray(zemin) > 0] = OY_RENK["zemin"]
    gorsel[np.asarray(engel) > 0] = OY_RENK["engel"]   # engel EN ÜSTTE çizilir
    return gorsel


def piksel_to_dunya(wps_px, htab_cx, htab_cy):
    """Model waypoint'leri (mozaik pikseli, alt→üst) → dünya (x,y) listesi (güney→kuzey)."""
    out = []
    for (px, py) in wps_px:
        wx = htab_cx + (px - MOZ_PX / 2) * MPP
        wy = htab_cy + (MOZ_PX / 2 - py) * MPP
        out.append((round(wx, 2), round(wy, 2)))
    return out


def dunya_to_piksel(xy, htab_cx, htab_cy):
    """Dunya ``(x, y)`` koordinatini kuzey-yukari mozaik pikseline cevir."""
    if xy is None:
        return None
    wx, wy = float(xy[0]), float(xy[1])
    if not math.isfinite(wx) or not math.isfinite(wy):
        return None
    return (int(round((wx - htab_cx) / MPP + MOZ_PX / 2)),
            int(round(MOZ_PX / 2 - (wy - htab_cy) / MPP)))


def _tohum_maskesi(xy, htab_cx, htab_cy, sekil, kenar_m):
    """KB/HB'nin fiziksel karesini mozaik pikselinde ikili maske olarak üret."""
    import numpy as np

    maske = np.zeros(sekil, np.uint8)
    nokta = dunya_to_piksel(xy, htab_cx, htab_cy)
    if nokta is None:
        return maske
    x, y = nokta
    h, w = sekil
    if not (0 <= x < w and 0 <= y < h):
        return maske
    kenar_px = max(1, int(round(float(kenar_m) / MPP)))
    x0 = x - kenar_px // 2
    y0 = y - kenar_px // 2
    x1 = x0 + kenar_px
    y1 = y0 + kenar_px
    maske[max(0, y0):min(h, y1), max(0, x0):min(w, x1)] = 1
    return maske


def _htab_icerik_kutusu(sekil):
    """56 m mozaikteki merkezî 50 m HTAB karesini piksel kutusu olarak dön."""
    h, w = sekil[:2]
    kenar_orani = (MOZ_M - HTAB_M) / (2.0 * MOZ_M)
    x0 = int(round(w * kenar_orani))
    y0 = int(round(h * kenar_orani))
    return (x0, y0, max(0, w - 2 * x0), max(0, h - 2 * y0))


def _tohumlari_c_uzayinda_hazirla(costmap_maskeleri, baslangic_xy, hb_xy,
                                   htab_cx, htab_cy, icerik):
    """Fiziksel KB/HB karelerini yalnız doğrulanmış C-uzayıyla kesiştir.

    Kareler hiçbir pikseli geçilebilir yapmaz. Önce zemin−engel ve gövde
    açıklığı hesaplanır; tohumlar bu kümenin dışında sıfırlanır.
    """
    import numpy as np

    sonuc = serbest_alan(
        costmap_maskeleri, mpp=MPP,
        yol_sinif_idler=COSTMAP_YOL_KATMANLARI,
        engel_sinif_idler=COSTMAP_ENGEL_KATMANLARI,
        icerik=icerik,
    )
    gecilebilir = (sonuc["dt_px"] >= sonuc["olcek"]["r_gerekli_px"])
    sekil = costmap_maskeleri[0].shape
    kb_ham = _tohum_maskesi(
        baslangic_xy, htab_cx, htab_cy, sekil, KB_TOHUM_KENAR_M)
    hb_ham = _tohum_maskesi(
        hb_xy, htab_cx, htab_cy, sekil, HB_TOHUM_KENAR_M)
    kb_tohum = np.logical_and(kb_ham > 0, gecilebilir).astype(np.uint8)
    hb_tohum = np.logical_and(hb_ham > 0, gecilebilir).astype(np.uint8)
    return {
        "kb_ham": kb_ham,
        "hb_ham": hb_ham,
        "kb_tohum": kb_tohum,
        "hb_tohum": hb_tohum,
        "gecilebilir": gecilebilir.astype(np.uint8),
        "serbest": sonuc["serbest"],
    }


