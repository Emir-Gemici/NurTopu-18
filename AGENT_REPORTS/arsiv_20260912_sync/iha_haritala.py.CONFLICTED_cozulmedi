def _bos_tuval():
    import numpy as np
    return np.full((MOZ_PX, MOZ_PX, 3), BG_GRI, dtype=np.uint8)


def _tuvale_yaz(yerlesim, tuval):
    """Kareyi (BGR) mozaik tuvaline yapıştır — sonra gelen öncekinin üstüne yazar."""
    import cv2

    kaynak, maske = yerlesim.yansit(yerlesim.ham, olcek_interp=cv2.INTER_AREA,
                                    dondur_interp=cv2.INTER_LINEAR,
                                    kenar=(BG_GRI,) * 3)
    yerlesim.dilim(tuval)[maske] = kaynak[maske]


def mozaik_kur(kare_dir, pozlar, htab_cx, htab_cy, kare_ofset=0, rot_isaret=1.0,
               debug=False):
    """Tarama karelerini kuzey-yukarı saha haritasına diz → (mozaik BGR, kullanılan_n).

    ⚠ Bu mozaik artık YALNIZCA GÖRSEL KANITTIR (ortomozaik.jpg / algi.jpg).
    Karar zinciri `oy_haritasi_kur()`ten çıkar: model ham karelerde koşar, oylar
    dünya ızgarasında birikir. Mozaik ölçüldü ve engel algısını ~21× yok ediyor.
    """
    kullanilan = 0
    canvas = _bos_tuval()
    for yerlesim in _kare_yerlesimleri(kare_dir, pozlar, htab_cx, htab_cy,
                                       kare_ofset=kare_ofset,
                                       rot_isaret=rot_isaret, debug=debug):
        _tuvale_yaz(yerlesim, canvas)
        kullanilan += 1
    return canvas, kullanilan


