            yol.unlink()


def _dosya_sha256(yol):
    """Varsa model dosyasının SHA-256 özetini dön; dizin/eksik yol uydurulmaz."""
    if not yol:
        return None
    aday = Path(str(yol))
    if not aday.is_absolute():
        aday = ROOT / aday
    if not aday.is_file():
        return None
    ozet = hashlib.sha256()
    with aday.open("rb") as akis:
        for parca in iter(lambda: akis.read(1024 * 1024), b""):
            ozet.update(parca)
    return ozet.hexdigest()


def _model_yolu(model, acik_yol=None):
    if acik_yol:
        return str(acik_yol)
    yol = getattr(model, "ckpt_path", None) if model is not None else None
    if yol:
        return str(yol)
    overrides = getattr(model, "overrides", None) if model is not None else None
    if isinstance(overrides, dict) and overrides.get("model"):
        return str(overrides["model"])
    return None


def _model_adlari(model):
    adlar = getattr(model, "names", None) if model is not None else None
    if isinstance(adlar, dict):
        return {str(k): str(v) for k, v in adlar.items()}
    if isinstance(adlar, (list, tuple)):
        return [str(v) for v in adlar]
    return None


def _maske_ozeti(maskeler=None, arac=None):
    """Model katmanlarını piksel sayısı ve tüm mozaik yüzdesiyle özetle."""
    import numpy as np

    if maskeler is None:
        trav = moloz = np.zeros((MOZ_PX, MOZ_PX), dtype=np.uint8)
    else:
        trav = np.asarray(maskeler[0]) > 0
        moloz = np.asarray(maskeler[1]) > 0
    if arac is None:
        arac_m = np.zeros_like(trav, dtype=bool)
    else:
        arac_m = np.asarray(arac) > 0
    engel = np.logical_or(moloz, arac_m)
    toplam = max(1, int(trav.size))

    def bilgi(maske):
        n = int(np.count_nonzero(maske))
        return n, round(100.0 * n / toplam, 4)

    trav_n, trav_yuzde = bilgi(trav)
    moloz_n, moloz_yuzde = bilgi(moloz)
    arac_n, arac_yuzde = bilgi(arac_m)
    engel_n, engel_yuzde = bilgi(engel)
    return {
        "toplam_px": toplam,
        "trav_px": trav_n,
        "trav_yuzde": trav_yuzde,
        "moloz_px": moloz_n,
        "moloz_yuzde": moloz_yuzde,
        "arac_px": arac_n,
        "arac_yuzde": arac_yuzde,
        "engel_px": engel_n,
        "engel_yuzde": engel_yuzde,
    }


def _oylama_ozeti(ozet=None):
    """Oylama alanlarını her yolda (hata yolları dâhil) AYNI şemayla dön."""
    temel = {
        "yontem": "kare_basi_oylama",
        "kare_sayisi": 0,
        "min_gozlem": MIN_GOZLEM,
        "engel_orani": ENGEL_ORANI,
        "bilinmeyen_hucre_orani": 1.0,
        "ortalama_gozlem": 0.0,
        "cikarim_sn": 0.0,
    }
    if ozet:
        temel.update({k: ozet[k] for k in temel if k in ozet})
    return temel


